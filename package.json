{
  "name": "doorman",
  "version": "0.1.0",
  "description": "Backend service for managing identities, authentication, and access control.",
  "type": "module",
  "scripts": {
    "dev": "tsx --env-file=.env ./src/server.ts",
    "build": "tsc && tsc-alias",
    "start": "node ./dist/server.js",
    "db:migrate": "tsx --env-file=.env ./src/database/scripts/migrate.ts",
    "db:rollback": "tsx --env-file=.env ./src/database/scripts/rollback.ts"
  },
  "keywords": [
    "api",
    "identity",
    "authentication",
    "authorization"
  ],
  "author": "Luiz Gustavo Siqueira Fenilli <gustavofenilli@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fenilli/doorman.git"
  },
  "homepage": "https://github.com/fenilli/doorman#readme",
  "bugs": "https://github.com/fenilli/doorman/issues",
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/env": "^7.0.0",
    "@fastify/jwt": "^10.2.2",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/sensible": "^6.0.5",
    "@fastify/type-provider-typebox": "^6.1.0",
    "argon2": "^0.45.1",
    "fastify": "^5.12.5",
    "fastify-plugin": "^6.0.0",
    "kysely": "^0.29.6",
    "pg": "^8.23.0",
    "typebox": "^1.3.34"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/pg": "^8.23.1",
    "pino-pretty": "^13.1.3",
    "tsc-alias": "^1.9.5",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
