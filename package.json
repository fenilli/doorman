{
  "type": "module",
  "name": "doorman",
  "version": "0.1.0",
  "scripts": {
    "dev": "tsx watch --env-file .env src/server.ts",
    "build": "tsc && tsc-alias && cpx2 \"src/views/**/*.eta\" dist/views",
    "start": "node dist/server.js",
    "db:migrate": "tsx --env-file .env src/commands/db/migrate.ts",
    "make:migration": "tsx src/commands/make/migration.ts",
    "keys:rotate": "tsx --env-file .env src/commands/keys/rotate.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/csrf-protection": "^8.0.1",
    "@fastify/formbody": "^9.0.0",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/sensible": "^6.0.6",
    "@fastify/type-provider-typebox": "^6.1.0",
    "@fastify/view": "^12.0.0",
    "argon2": "^0.45.1",
    "eta": "^4.6.0",
    "fastify": "^5.12.5",
    "fastify-plugin": "^6.0.0",
    "jose": "^6.2.12",
    "kysely": "^0.29.6",
    "pg": "^8.23.0",
    "typebox": "^1.3.34"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "cpx2": "^9.0.3",
    "pino-pretty": "^13.1.3",
    "tsc-alias": "^1.9.7",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
