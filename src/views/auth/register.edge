@layout.app({ title: 'Create account' })
<h1>Create account</h1>
@if(error)
<p class="error" role="alert">{{ error }}</p>
@end
<form method="post" action="/register">
  <input type="hidden" name="return_to" value="{{ returnTo }}">
  <input type="hidden" name="_csrf" value="{{ csrfToken }}">
  <label>Name (optional)
    <input name="name" type="text" value="{{ name || '' }}" autocomplete="name" maxlength="100">
  </label>
  <label>Email
    <input name="email" type="email" value="{{ email || '' }}" autocomplete="username" required>
  </label>
  <label>Password (8 to 64 characters)
    <input name="password" type="password" autocomplete="new-password" minlength="8" maxlength="64" required>
  </label>
  <button type="submit">Create account</button>
</form>
<p>Already registered? <a href="{{ loginUrl }}">Sign in</a></p>
@end
