<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= it.title ? it.title + " - doorman" : "doorman" %></title>
    <style>
      :root { color-scheme: light dark; }
      body { font-family: system-ui, sans-serif; margin: 0; min-height: 100vh; display: grid; place-items: center; }
      main { width: min(22rem, 90vw); }
      h1 { font-size: 1.4rem; }
      label { display: block; margin: 0 0 1rem; font-size: .9rem; }
      input { display: block; width: 100%; box-sizing: border-box; margin-top: .3rem; padding: .55rem; font: inherit; }
      button { width: 100%; padding: .6rem; font: inherit; cursor: pointer; }
      .error { padding: .6rem; border: 1px solid #c0392b; border-radius: 4px; color: #c0392b; }
    </style>
  </head>

  <body>
    <main>
      <%~ it.body %>
    </main>
  </body>
</html>
